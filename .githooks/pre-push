#!/bin/sh
# Run pre-commit's pre-push hooks from the locked environment of the checkout
# Git is committing or pushing in. `git config core.hooksPath .githooks`
# selects this script (README.md#development-setup). Git runs a hook at the
# root of its working tree, so `uv run` resolves that checkout's own `.venv`
# and no interpreter path is written into the Git directory every checkout
# shares.
#
# `pre-commit hook-impl` is a hidden pre-commit command, what the scripts
# `pre-commit install` generates run, so an upgrade of pre-commit must check
# that these scripts still work. It takes no `--hook-dir` here: that option
# only runs a `<hook>.legacy` script beside the hook, which `.githooks/` has
# none of. Leaving it out needs pre-commit 4.6.0 or later, which accepts a
# missing `--hook-dir` for Git 2.54's configured hooks; the config's
# `minimum_pre_commit_version` and `uv.lock` both hold that floor.
set -e

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-push hook: uv is not on PATH; see README.md#development-setup" >&2
    exit 1
fi

exec uv run --locked pre-commit hook-impl \
    --config=.pre-commit-config.yaml --hook-type=pre-push -- "$@"
