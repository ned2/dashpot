Screen {
    layout: vertical;
}

FooterKey.-disabled {
    display: none;
}

PeerStatusBar {
    width: 1fr;
    height: 1;
    layout: horizontal;
    background: $surface;
}

#peer-status-screens {
    width: auto;
    height: 1;
}

PeerSelector {
    width: auto;
    height: 1;
    margin-right: 1;
    padding: 0 1;
    background: $surface-lighten-1;
    color: $text-muted;
}

PeerSelector:hover {
    background: $boost;
    color: $text;
}

PeerSelector.-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#peer-summary {
    width: 1fr;
    height: 1;
    padding: 0 1;
    text-align: right;
    color: $text-muted;
}

Screen.-compact PeerStatusBar {
    height: 2;
    layout: vertical;
}

Screen.-compact #peer-summary {
    text-align: left;
}

/* A pinned agent-activity column keeps its place under horizontal scroll
   without a colour of its own. Textual paints fixed columns
   `$secondary-muted`, a band that would compete with the lit related-activity
   cell on Dashboard, and the Issue table follows so the column reads the
   same on every peer. Transparent lets the table's own background, and its
   focus tint, show through. */
FocusCursorTable > .datatable--fixed {
    background: transparent;
}

/* Related-row emphasis lights only the activity cell, in a violet no
   activity Glyph uses and distinct from the cursor, dark and light chosen so
   every activity Glyph keeps its contrast on it. */
FocusCursorTable:dark > .datatable--related-activity {
    background: #3c1e70;
}

FocusCursorTable:light > .datatable--related-activity {
    background: #e2d9ff;
}

/* A header tooltip is a column's description with its Glyph meanings, a
   short paragraph rather than a phrase; Textual's 40-cell default wraps
   the Branches INTEGRATED help into a box taller than many terminals. */
Tooltip {
    max-width: 72;
}

/* The exceptional-state alert appears and disappears with every refresh. It
   floats on the body's own readout layer rather than taking a row from the
   flow, because a peer body that changed height by one row would re-fit every
   list pane under it and shift the rows a person is reading. Textual computes
   dock spacing per layer, so a bottom-docked widget on `readout` overlays the
   body's last row without shrinking `default`, the layer the panes are laid
   out in. `default` is named here rather than invented: a widget that sets no
   `layer` of its own reports that name, so declaring any other first layer
   would leave the panes matching none of them and order them only by the
   compositor's fallback. The Diagnostics box stays in the flow below the body:
   it is durable detail rather than refresh chrome, and up to five rows of it
   over the panes would hide more than it told. */
#body,
#query-body {
    height: 1fr;
    layers: default readout;
    layout: vertical;
    overflow-x: auto;
}

/* The panes stack full-width, each with the same one-row top gutter. The first
   gutter separates content from the Peer Status Bar; every later one separates
   adjacent panes. Dashboard lists seek enough height for every record and
   share the available body when constrained; the bounded Pull Requests list
   leaves the flexible Issue pane its minimum. */
#list-row,
#query-list-row {
    width: 1fr;
    height: auto;
    layout: vertical;
}

ListPane,
#queue-pane {
    margin-top: 1;
}

ListPane {
    width: 1fr;
    height: auto;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
}

/* Source freshness is a secondary fact on the opposite end of a pane's frame,
   distinct from its label and count. */
#branches-pane,
#pull-requests-pane {
    border-subtitle-align: right;
    border-subtitle-color: $text-muted;
    border-subtitle-style: none;
}

/* Each table's content-height cap is fitted to the live Peer Screen body by
   `pane_layout.fit_panes`; the stylesheet only supplies the canvas. */
ListPane > FocusCursorTable {
    height: auto;
    background: $background;
}

.list-pane-empty {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: italic;
}

#queue-pane {
    width: 1fr;
    height: 1fr;
    min-height: 6;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
}

/* The focused list is cued by its border colour, like the Issue view panes. */
#queue-pane:focus-within,
ListPane:focus-within {
    border: round $primary;
}

ItemFilterBar {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

ItemFilterBar > .item-state {
    width: 14;
    margin-right: 1;
}

ItemFilterBar > .item-search {
    width: 1fr;
    margin-right: 1;
}

ItemFilterBar > .item-count {
    width: auto;
    height: 1;
    color: $text-muted;
}

Screen.-compact #issue-search {
    min-width: 21;
}

Screen.-compact #issue-count {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#queue {
    height: 1fr;
    background: $background;
}

DetailRow {
    width: 1fr;
    height: auto;
    min-height: 1;
    layout: horizontal;
}

DetailRow > .field-name {
    width: 11;
    height: 1;
    margin-right: 1;
    color: $text-muted;
    text-style: bold;
    text-align: left;
}

DetailRow > .field-value {
    width: 1fr;
    height: auto;
    color: $text;
}

DetailRow.-heading > .field-name,
DetailRow.-section > .field-name,
DetailRow.-list > .field-name,
DetailRow.-message > .field-name {
    display: none;
}

DetailRow.-heading > .field-value {
    text-style: bold;
}

DetailRow.-section > .field-value {
    color: $text-muted;
    text-style: bold;
}

DetailRow.-list > .field-value {
    padding-left: 2;
    color: $text-muted;
}

#alert {
    display: none;
    layer: readout;
    dock: bottom;
    width: 1fr;
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    text-style: bold;
}

#alert.-visible {
    display: block;
}

#alert.-error {
    color: $text;
    background: $error;
}

#alert.-warning {
    color: $text;
    background: $warning-darken-2;
}

#alert.-info {
    color: $text-muted;
    background: $surface;
}

#diagnostics {
    display: none;
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    overflow-y: auto;
}

#diagnostics.-has-messages {
    display: block;
}

/* The box takes the colour of its most severe line, so a locked Worktree
   and a failed refresh no longer read alike. */
#diagnostics.-info {
    color: $text-muted;
}

#diagnostics.-warning {
    color: $warning;
}

#diagnostics.-error {
    color: $error;
}

/* Give every visible key binding an equal share of the footer instead of
   packing the bindings against the left edge. */
Footer > FooterKey {
    width: 1fr;
    text-align: center;
}

Footer > FooterKey.-command-palette {
    width: auto;
}

Screen.-compact #diagnostics {
    max-height: 3;
}

IssueColumnEditor {
    align: center middle;
    background: $background 70%;
}

#column-editor-dialog {
    width: 56;
    height: auto;
    max-height: 26;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#column-editor-title {
    height: 1;
    color: $text;
    text-style: bold;
}

#column-editor-help {
    height: 2;
    margin: 1 0;
    color: $text-muted;
}

#column-editor-list {
    height: 12;
}

/* The marked toggles draw the X only when on, so every button state shares
   one colour and the mark alone carries the state. */
#column-editor-list > .selection-list--button,
#column-editor-list > .selection-list--button-selected,
#column-editor-list > .selection-list--button-highlighted,
#column-editor-list > .selection-list--button-selected-highlighted {
    color: $text;
}

#column-editor-error {
    height: 1;
    color: $error;
}

#column-editor-actions {
    height: 3;
    align-horizontal: right;
}

#column-editor-actions Button {
    width: auto;
    min-width: 8;
    margin-left: 1;
}

/* The Legend: a modal that costs nothing while closed. */
LegendScreen {
    align: center middle;
    background: $background 70%;
}

#legend-dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#legend-title {
    height: 1;
    color: $text;
    text-style: bold;
}

.legend-heading {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

.legend-section {
    height: auto;
    color: $text;
}

/* Full-screen Issue view. */
#issue-view {
    height: 1fr;
    layout: vertical;
}

#issue-view-heading {
    height: 1;
    margin: 0;
}

#issue-view-location {
    width: 1fr;
    height: 1;
    margin-right: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#issue-view-subtitle {
    width: auto;
    height: 1;
    color: $text-muted;
    text-align: right;
    text-style: italic;
}

#issue-view-panes {
    height: 1fr;
    layout: horizontal;
}

#issue-view-body {
    width: 1fr;
    height: 1fr;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
    padding: 0 1;
}

#issue-view-body:focus,
#issue-view-metadata:focus {
    border: round $primary;
}

/* Both panes' border lines track the Issue's state (GitHub Primer StateLabel
   emphasis colours, supplied per theme as `$issue-*` by the app); the
   focused pane shows the colour in full and the other one dimmed, and the
   titles stay in the ordinary text colour. */
#issue-view.-issue-open #issue-view-body,
#issue-view.-issue-open #issue-view-metadata {
    border: round $issue-open 60%;
}

#issue-view.-issue-open #issue-view-body:focus,
#issue-view.-issue-open #issue-view-metadata:focus {
    border: round $issue-open;
}

#issue-view.-issue-completed #issue-view-body,
#issue-view.-issue-completed #issue-view-metadata {
    border: round $issue-completed 60%;
}

#issue-view.-issue-completed #issue-view-body:focus,
#issue-view.-issue-completed #issue-view-metadata:focus {
    border: round $issue-completed;
}

#issue-view.-issue-not-planned #issue-view-body,
#issue-view.-issue-not-planned #issue-view-metadata {
    border: round $issue-not-planned 60%;
}

#issue-view.-issue-not-planned #issue-view-body:focus,
#issue-view.-issue-not-planned #issue-view-metadata:focus {
    border: round $issue-not-planned;
}

#issue-view.-issue-duplicate #issue-view-body,
#issue-view.-issue-duplicate #issue-view-metadata {
    border: round $issue-duplicate 60%;
}

#issue-view.-issue-duplicate #issue-view-body:focus,
#issue-view.-issue-duplicate #issue-view-metadata:focus {
    border: round $issue-duplicate;
}

#issue-view-markdown {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
}

#issue-view-empty {
    color: $text-muted;
    text-style: italic;
}

#issue-view-metadata {
    width: 40;
    height: 1fr;
    margin-left: 1;
    padding: 0 1;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
}

#issue-view.-stacked #issue-view-panes {
    layout: vertical;
}

#issue-view.-stacked #issue-view-body {
    height: 2fr;
}

#issue-view.-stacked #issue-view-metadata {
    width: 1fr;
    height: 1fr;
    margin-left: 0;
    margin-top: 1;
}

/* Headings carry a two-row top margin for spacing between sections; the
   first block of the body should follow the Issue byline directly. */
#issue-view-markdown > MarkdownBlock:first-of-type {
    margin-top: 0;
}

/* The Cleanup modals: a preview to select from, then the outcomes. */
CleanupScreen, CleanupReportScreen {
    align: center middle;
    background: $background 70%;
}

#cleanup-dialog, #cleanup-report-dialog {
    width: 96;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round $error;
    background: $surface;
}

#cleanup-report-dialog {
    border: round $primary;
}

#cleanup-title, #cleanup-report-title {
    height: auto;
    color: $text;
    text-style: bold;
}

#cleanup-body {
    height: auto;
    max-height: 1fr;
    min-height: 3;
}

#cleanup-subject {
    height: auto;
    text-style: bold;
}

#cleanup-context, #cleanup-freshness {
    height: auto;
    color: $text-muted;
}

#cleanup-freshness, #cleanup-help {
    margin-top: 1;
    height: auto;
}

#cleanup-targets, .cleanup-target {
    height: auto;
}

.cleanup-target {
    margin-top: 1;
}

.cleanup-target-heading {
    height: auto;
}

.cleanup-primary {
    height: auto;
    width: 1fr;
    text-style: bold;
}

#cleanup-fetch-status {
    height: auto;
    color: $text;
}

#cleanup-footer Footer {
    dock: none;
    height: 1;
}

.cleanup-target CleanupChoice {
    width: 1fr;
    height: auto;
    border: none;
    padding: 0;
    text-wrap: wrap;
    text-style: bold;
}

.cleanup-target CleanupChoice > .toggle--button,
.cleanup-target CleanupChoice.-on > .toggle--button {
    color: $text;
}

.cleanup-availability {
    width: auto;
    height: 1;
    margin-left: 1;
    color: $success;
    text-style: bold;
}

.cleanup-availability.-blocked, .cleanup-blocker {
    color: $warning;
}

.cleanup-blocker, .cleanup-summary {
    height: auto;
    margin-left: 4;
}

#cleanup-help.cleanup-blocker {
    margin-left: 0;
}

.cleanup-target Collapsible {
    padding: 0 0 0 3;
    border: none;
}

.cleanup-target Collapsible > Contents {
    padding: 0 0 0 2;
}

.cleanup-target Collapsible Static {
    height: auto;
}

/* The confirm button's label is fixed, so this recap of the selection is
   what a person reads before confirming; it ends the scrolling body. */
#cleanup-callout {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    border: tall $error;
    background: $error 15%;
}

#cleanup-callout-title {
    height: auto;
    text-style: bold;
}

#cleanup-callout-lines {
    height: auto;
    color: $text;
}

#cleanup-footer {
    dock: bottom;
    height: auto;
    background: $surface;
    padding-top: 1;
}

#cleanup-problem {
    height: auto;
    min-height: 1;
    color: $warning;
}

#cleanup-report {
    height: auto;
    margin: 1 0;
}

#cleanup-actions, #cleanup-report-actions {
    height: 3;
    align-horizontal: right;
}

#cleanup-actions Button, #cleanup-report-actions Button {
    width: auto;
    min-width: 8;
    margin-left: 1;
}
