Screen {
    layout: vertical;
}

#body {
    height: 1fr;
    layout: vertical;
    overflow-x: auto;
}

#detail-row {
    width: 1fr;
    height: 1fr;
    min-height: 7;
    margin-bottom: 1;
    layout: horizontal;
}

#queue-pane {
    width: 1fr;
    height: 1fr;
    min-height: 6;
    border: round $primary-darken-2;
}

#project-pane {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
    border: round $primary-darken-2;
}

#selection-pane {
    width: 1fr;
    height: 1fr;
    border: round $primary-darken-2;
}

Screen.-compact Header {
    display: none;
}

.pane-title {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#queue-controls {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

#queue-controls .pane-title {
    width: auto;
    padding-left: 0;
    margin-right: 1;
}

#issue-state {
    width: 14;
    margin-right: 1;
}

#issue-search {
    width: 1fr;
    margin-right: 1;
}

#issue-count {
    width: 16;
    height: 1;
    content-align: right middle;
    color: $text-muted;
}

#queue {
    height: 1fr;
}

#project-detail {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

#selection-detail {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

#diagnostics {
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    overflow-y: auto;
}

#diagnostics.-has-messages {
    color: $warning;
}

Screen.-compact #diagnostics {
    max-height: 3;
}

IssueColumnEditor {
    align: center middle;
    background: $background 70%;
}

#column-editor-dialog {
    width: 56;
    height: auto;
    max-height: 26;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#column-editor-title {
    height: 1;
    color: $text;
    text-style: bold;
}

#column-editor-help {
    height: 2;
    margin: 1 0;
    color: $text-muted;
}

#column-editor-list {
    height: 12;
}

#column-editor-error {
    height: 1;
    color: $error;
}

#column-editor-actions {
    height: 3;
    align-horizontal: right;
}

#column-editor-actions Button {
    width: auto;
    min-width: 8;
    margin-left: 1;
}
