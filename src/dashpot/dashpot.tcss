Screen {
    layout: vertical;
}

#body {
    height: 1fr;
    layout: vertical;
    overflow-x: auto;
}

#detail-row {
    width: 1fr;
    height: 1fr;
    min-height: 7;
    margin-bottom: 1;
    layout: horizontal;
}

#queue-pane {
    width: 1fr;
    height: 1fr;
    min-height: 6;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
}

#project-pane,
#selection-pane {
    width: 1fr;
    height: 1fr;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
}

#project-pane {
    margin-right: 1;
}

/* Only the border line tracks the selected Issue's state (GitHub Primer
   StateLabel emphasis colors); the title stays in the ordinary text colour. */
#selection-pane {
    border-title-color: $foreground;
}

#selection-pane.-issue-open {
    border: round #1f883d;
}

#selection-pane.-issue-completed {
    border: round #8250df;
}

#selection-pane.-issue-not-planned,
#selection-pane.-issue-duplicate {
    border: round #59636e;
}

Screen:dark #selection-pane.-issue-open {
    border: round #238636;
}

Screen:dark #selection-pane.-issue-completed {
    border: round #8957e5;
}

Screen:dark #selection-pane.-issue-not-planned,
Screen:dark #selection-pane.-issue-duplicate {
    border: round #656c76;
}

Screen.-compact Header {
    display: none;
}

#queue-controls {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

#issue-state {
    width: 14;
    margin-right: 1;
}

#issue-search {
    width: 1fr;
    margin-right: 1;
}

#issue-count {
    width: auto;
    height: 1;
    color: $text-muted;
}

#queue {
    height: 1fr;
    /* The table sits on the pane canvas, so the space below the last row is
       never mistaken for a stripe. Odd rows deliberately stay unset and
       inherit that canvas; even rows are the single highlight stripe, tinted
       from the foreground so it reads in both light and dark themes. */
    background: $background;
}

#queue > .datatable--even-row {
    background: $foreground 8%;
}

#project-detail,
#selection-detail {
    height: 1fr;
    padding: 0 1;
}

DetailRow {
    width: 1fr;
    height: auto;
    min-height: 1;
    layout: horizontal;
}

DetailRow > .field-name {
    width: 11;
    height: 1;
    margin-right: 1;
    color: $text-muted;
    text-style: bold;
    text-align: left;
}

DetailRow > .field-value {
    width: 1fr;
    height: auto;
    color: $text;
}

DetailRow.-heading > .field-name,
DetailRow.-section > .field-name,
DetailRow.-list > .field-name,
DetailRow.-message > .field-name {
    display: none;
}

DetailRow.-heading > .field-value {
    text-style: bold;
}

DetailRow.-section > .field-value {
    color: $text-muted;
    text-style: bold;
}

DetailRow.-list > .field-value {
    padding-left: 2;
    color: $text-muted;
}

#alert {
    display: none;
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    text-style: bold;
}

#alert.-visible {
    display: block;
}

#alert.-error {
    color: $text;
    background: $error;
}

#alert.-warning {
    color: $text;
    background: $warning-darken-2;
}

#alert.-info {
    color: $text-muted;
    background: $surface;
}

#diagnostics {
    display: none;
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    overflow-y: auto;
}

#diagnostics.-has-messages {
    display: block;
    color: $warning;
}

Screen.-compact #diagnostics {
    max-height: 3;
}

IssueColumnEditor {
    align: center middle;
    background: $background 70%;
}

#column-editor-dialog {
    width: 56;
    height: auto;
    max-height: 26;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#column-editor-title {
    height: 1;
    color: $text;
    text-style: bold;
}

#column-editor-help {
    height: 2;
    margin: 1 0;
    color: $text-muted;
}

#column-editor-list {
    height: 12;
}

#column-editor-error {
    height: 1;
    color: $error;
}

#column-editor-actions {
    height: 3;
    align-horizontal: right;
}

#column-editor-actions Button {
    width: auto;
    min-width: 8;
    margin-left: 1;
}

/* Full-screen Issue view. */
#issue-view {
    height: 1fr;
    layout: vertical;
}

#issue-view-heading {
    height: auto;
    margin: 1 0;
}

#issue-view-title {
    height: auto;
    text-style: bold;
}

#issue-view-subtitle {
    height: auto;
    color: $text-muted;
}

#issue-view-panes {
    height: 1fr;
    layout: horizontal;
}

#issue-view-body {
    width: 1fr;
    height: 1fr;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    padding: 0 1;
}

#issue-view-body:focus,
#issue-view-metadata:focus {
    border: round $primary;
}

#issue-view-markdown {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
}

#issue-view-empty {
    color: $text-muted;
    text-style: italic;
}

#issue-view-metadata {
    width: 40;
    height: 1fr;
    margin-left: 1;
    padding: 0 1;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
}

#issue-view.-stacked #issue-view-panes {
    layout: vertical;
}

#issue-view.-stacked #issue-view-body {
    height: 2fr;
}

#issue-view.-stacked #issue-view-metadata {
    width: 1fr;
    height: 1fr;
    margin-left: 0;
    margin-top: 1;
}

/* Headings carry a two-row top margin for spacing between sections; the
   first block of the body should follow the Issue heading directly. */
#issue-view-markdown > MarkdownBlock:first-of-type {
    margin-top: 0;
}
