Screen {
    layout: vertical;
}

#body {
    height: 1fr;
    layout: vertical;
    overflow-x: auto;
}

/* The Sessions, Branches and Worktrees panes stack full-width above the Issue table,
   each sized to its content: a pane grows with its records up to the cap on
   its table and scrolls beyond it, so the Issue table only pays for rows in
   use. Each pane carries the blank line below it, which separates it from the
   next pane and, for the last one, from the Issue table. */
#list-row {
    width: 1fr;
    height: auto;
    layout: vertical;
}

#sessions-pane,
#worktrees-pane,
#branches-pane {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
}

/* Remote freshness is a secondary fact on the opposite end of the Branches
   pane's frame, distinct from its label and count. */
#branches-pane {
    border-subtitle-align: right;
    border-subtitle-color: $text-muted;
    border-subtitle-style: none;
}

/* Each table's cap is set by the app from the height left over after the
   detail row and the Issue table keep their minimums (see
   `DashpotApp.fit_list_panes`); the stylesheet only supplies the canvas. */
#sessions,
#worktrees,
#branches {
    height: auto;
    background: $background;
}

.list-pane-empty {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: italic;
}

#queue-pane {
    width: 1fr;
    height: 1fr;
    min-height: 6;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
}

/* The focused list is cued by its border colour, like the Issue view panes. */
#queue-pane:focus-within,
#sessions-pane:focus-within,
#worktrees-pane:focus-within,
#branches-pane:focus-within {
    border: round $primary;
}

#queue-controls {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

#issue-state {
    width: 14;
    margin-right: 1;
}

#issue-search {
    width: 1fr;
    margin-right: 1;
}

#issue-count {
    width: auto;
    height: 1;
    color: $text-muted;
}

#queue {
    height: 1fr;
    background: $background;
}

DetailRow {
    width: 1fr;
    height: auto;
    min-height: 1;
    layout: horizontal;
}

DetailRow > .field-name {
    width: 11;
    height: 1;
    margin-right: 1;
    color: $text-muted;
    text-style: bold;
    text-align: left;
}

DetailRow > .field-value {
    width: 1fr;
    height: auto;
    color: $text;
}

DetailRow.-heading > .field-name,
DetailRow.-section > .field-name,
DetailRow.-list > .field-name,
DetailRow.-message > .field-name {
    display: none;
}

DetailRow.-heading > .field-value {
    text-style: bold;
}

DetailRow.-section > .field-value {
    color: $text-muted;
    text-style: bold;
}

DetailRow.-list > .field-value {
    padding-left: 2;
    color: $text-muted;
}

#alert {
    display: none;
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    text-style: bold;
}

#alert.-visible {
    display: block;
}

#alert.-error {
    color: $text;
    background: $error;
}

#alert.-warning {
    color: $text;
    background: $warning-darken-2;
}

#alert.-info {
    color: $text-muted;
    background: $surface;
}

#diagnostics {
    display: none;
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    overflow-y: auto;
}

#diagnostics.-has-messages {
    display: block;
}

/* The box takes the colour of its most severe line, so a locked Worktree
   and a failed refresh no longer read alike. */
#diagnostics.-info {
    color: $text-muted;
}

#diagnostics.-warning {
    color: $warning;
}

#diagnostics.-error {
    color: $error;
}

/* Give every visible key binding an equal share of the footer instead of
   packing the bindings against the left edge. */
Footer > FooterKey {
    width: 1fr;
    text-align: center;
}

Footer > FooterKey.-command-palette {
    width: auto;
}

Screen.-compact #diagnostics {
    max-height: 3;
}

IssueColumnEditor {
    align: center middle;
    background: $background 70%;
}

#column-editor-dialog {
    width: 56;
    height: auto;
    max-height: 26;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#column-editor-title {
    height: 1;
    color: $text;
    text-style: bold;
}

#column-editor-help {
    height: 2;
    margin: 1 0;
    color: $text-muted;
}

#column-editor-list {
    height: 12;
}

#column-editor-list > .selection-list--button,
#column-editor-list > .selection-list--button-selected,
#column-editor-list > .selection-list--button-highlighted,
#column-editor-list > .selection-list--button-selected-highlighted {
    color: $text;
}

#column-editor-error {
    height: 1;
    color: $error;
}

#column-editor-actions {
    height: 3;
    align-horizontal: right;
}

#column-editor-actions Button {
    width: auto;
    min-width: 8;
    margin-left: 1;
}

/* The Legend: a modal that costs nothing while closed. */
LegendScreen {
    align: center middle;
    background: $background 70%;
}

#legend-dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#legend-title {
    height: 1;
    color: $text;
    text-style: bold;
}

.legend-heading {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

.legend-section {
    height: auto;
    color: $text;
}

/* Full-screen Issue view. */
#issue-view {
    height: 1fr;
    layout: vertical;
}

#issue-view-heading {
    height: 1;
    margin: 0;
}

#issue-view-location {
    width: 1fr;
    height: 1;
    margin-right: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#issue-view-subtitle {
    width: auto;
    height: 1;
    color: $text-muted;
    text-align: right;
    text-style: italic;
}

#issue-view-panes {
    height: 1fr;
    layout: horizontal;
}

#issue-view-body {
    width: 1fr;
    height: 1fr;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
    padding: 0 1;
}

#issue-view-body:focus,
#issue-view-metadata:focus {
    border: round $primary;
}

/* Both panes' border lines track the Issue's state (GitHub Primer StateLabel
   emphasis colours, supplied per theme as `$issue-*` by the app); the
   focused pane shows the colour in full and the other one dimmed, and the
   titles stay in the ordinary text colour. */
#issue-view.-issue-open #issue-view-body,
#issue-view.-issue-open #issue-view-metadata {
    border: round $issue-open 60%;
}

#issue-view.-issue-open #issue-view-body:focus,
#issue-view.-issue-open #issue-view-metadata:focus {
    border: round $issue-open;
}

#issue-view.-issue-completed #issue-view-body,
#issue-view.-issue-completed #issue-view-metadata {
    border: round $issue-completed 60%;
}

#issue-view.-issue-completed #issue-view-body:focus,
#issue-view.-issue-completed #issue-view-metadata:focus {
    border: round $issue-completed;
}

#issue-view.-issue-not-planned #issue-view-body,
#issue-view.-issue-not-planned #issue-view-metadata {
    border: round $issue-not-planned 60%;
}

#issue-view.-issue-not-planned #issue-view-body:focus,
#issue-view.-issue-not-planned #issue-view-metadata:focus {
    border: round $issue-not-planned;
}

#issue-view.-issue-duplicate #issue-view-body,
#issue-view.-issue-duplicate #issue-view-metadata {
    border: round $issue-duplicate 60%;
}

#issue-view.-issue-duplicate #issue-view-body:focus,
#issue-view.-issue-duplicate #issue-view-metadata:focus {
    border: round $issue-duplicate;
}

#issue-view-markdown {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
}

#issue-view-empty {
    color: $text-muted;
    text-style: italic;
}

#issue-view-metadata {
    width: 40;
    height: 1fr;
    margin-left: 1;
    padding: 0 1;
    border: round $primary-darken-2;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $foreground;
}

#issue-view.-stacked #issue-view-panes {
    layout: vertical;
}

#issue-view.-stacked #issue-view-body {
    height: 2fr;
}

#issue-view.-stacked #issue-view-metadata {
    width: 1fr;
    height: 1fr;
    margin-left: 0;
    margin-top: 1;
}

/* Headings carry a two-row top margin for spacing between sections; the
   first block of the body should follow the Issue byline directly. */
#issue-view-markdown > MarkdownBlock:first-of-type {
    margin-top: 0;
}
